"<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#10243b\"><link rel=\"icon\" href=\"{{BASE}}icono.png\"><title>{{TITLE}} | fonzeka® Insights</title><style>\n:root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:#f6f8fa;color:#172c40}*{box-sizing:border-box}body{margin:0;line-height:1.65}header{background:#10243b;color:#fff;padding:22px 17px}header>div,main,footer{max-width:860px;margin:auto}.brand{display:flex;align-items:center;gap:10px}.brand img{width:58px;height:58px;object-fit:contain}.brand strong{font-size:26px;letter-spacing:-.7px}.brand span{color:#bcd2e2;font-size:16px}a{color:#08718b;overflow-wrap:anywhere}header a{color:#bfeafa;text-decoration:none;font-size:13px}main{padding:24px 17px 55px}.eyebrow{color:#157688;font-weight:750;letter-spacing:1px;font-size:11px;text-transform:uppercase}.lead{font-size:18px;color:#435c6c}.panel{background:#fff;border:1px solid #e1e8ef;border-radius:13px;padding:20px;margin:18px 0}.highlight{border-left:4px solid #ec8a39}h1{font-size:clamp(28px,5vw,39px);line-height:1.16;letter-spacing:-1px;margin:14px 0}h2{font-size:20px;margin:24px 0 10px}h3{font-size:15px}.meta{display:flex;flex-wrap:wrap;gap:8px}.meta span{font-size:12px;background:#e9f1f5;padding:6px 10px;border-radius:20px}.small{color:#667987;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.grid>div{background:#f1f5f8;border-radius:8px;padding:12px}.grid strong{display:block}ul{padding-left:20px}li{margin:8px 0}.btn{display:inline-block;padding:10px 13px;border-radius:9px;background:#e6f3f6;font-weight:700;text-decoration:none}footer{text-align:center;color:#6d7d88;font-size:12px;padding:20px}@media(max-width:620px){.grid{grid-template-columns:1fr}}\n</style></head><body><header><div><a href=\"{{BASE}}index.html\">← Volver al observatorio</a><div class=\"brand\"><img src=\"{{BASE}}logo-fonzeka.png\" alt=\"Isotipo fonzeka®\"><div><strong>fonzeka®</strong> <span>Insights</span></div></div></div></header><main>\n<div class=\"eyebrow\">Expediente documental DOF {{CODE}} / {{AGENCY}}</div>\n<h1>{{TITLE}}</h1><p class=\"lead\">{{RESUMEN}}</p>\n<div class=\"meta\"><span>Fuente · DOF / {{AGENCY}}</span><span>Publicación DOF · {{DATE}}</span><span>Versión editorial {{VERSION}}</span><span>Autorización editorial {{APPROVED}}</span></div>\n<div class=\"panel highlight\"><h2 style=\"margin-top:0\">¿Qué cambia?</h2>{{CAMBIOS}}</div>\n<section class=\"panel\"><h2 style=\"margin-top:0\">Antecedentes verificables</h2>{{ANTECEDENTES}}</section>\n<section class=\"panel\"><h2 style=\"margin-top:0\">Transitorios que requieren atención</h2>{{TRANSITORIOS}}</section>\n<section class=\"panel\"><h2 style=\"margin-top:0\">Implicaciones evaluadas por fonzeka®</h2>{{IMPLICACIONES}}</section>\n<section class=\"panel\"><h2 style=\"margin-top:0\">Evidencia y estado de revisión</h2><p><strong>Fuente primaria:</strong> {{TITLE}} · Código DOF {{CODE}}.</p>{{EVIDENCIA}}<p><strong>Alcance:</strong> {{SCOPE}}</p><a class=\"btn\" href=\"{{URL}}\" target=\"_blank\" rel=\"noopener noreferrer\">Consultar documento oficial íntegro ↗</a></section>\n<p class=\"small\">fonzeka® Insights es una iniciativa independiente. La fecha del DOF no debe confundirse con una fecha de entrada en vigor. La autorización editorial no constituye certificación jurídica. SHA-256 del contenido autorizado: {{HASH}}.</p><a href=\"{{BASE}}index.html\">← Regresar a la página principal</a></main><footer>fonzeka® Insights · Observatorio Inteligente del Sector Eléctrico Mexicano</footer></body></html>\n"
